meta {
  name: Mi usuario
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/usuarios/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("es el usuario del token", function() {
    expect(res.body.id).to.equal(bru.getVar("adminUserId"));
  });
}
