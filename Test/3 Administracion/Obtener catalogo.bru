meta {
  name: Obtener catalogo
  type: http
  seq: 4
}

get {
  url: {{tfm-api-gateway-local}}/api/catalogo/{{catalogoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("es el item creado", function() {
    expect(res.body.id).to.equal(bru.getVar("catalogoId"));
  });
}
