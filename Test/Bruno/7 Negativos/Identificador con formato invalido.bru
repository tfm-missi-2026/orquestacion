meta {
  name: Identificador con formato invalido
  type: http
  seq: 3
}
get {
  url: {{baseUrl}}/api/catalogo/no-es-un-uuid
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 400 y no 500", function() {
    expect(res.status).to.equal(400);
  });
  test("el codigo es de validacion fallida", function() {
    expect(res.body.title).to.equal("VALIDACION_FALLIDA");
  });
}
