meta {
  name: Crear subproyecto
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/api/subproyectos
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "proyectoId": "{{proyectoId}}",
    "tipoSubproyectoId": "{{catTipoSubproyecto}}",
    "codigoTicket": "QA-{{runId}}",
    "prioridadId": "{{catPrioridad}}",
    "descripcion": "Subproyecto creado por la coleccion Bruno",
    "solicitanteId": "{{adminUserId}}",
    "fechaSolicitud": "2026-08-03",
    "situacionId": "{{catSituacionPendiente}}"
  }
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("subproyectoId", res.body.id);
  }
}
tests {
  test("creado (200/201)", function() { expect(res.status).to.be.oneOf([200, 201]); });
  test("devuelve id", function() { expect(res.body.id).to.be.a("string"); });
  test("cuelga del proyecto creado", function() {
    expect(res.body.proyectoId).to.equal(bru.getVar("proyectoId"));
  });
}
