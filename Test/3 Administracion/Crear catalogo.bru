meta {
  name: Crear catalogo
  type: http
  seq: 3
}

post {
  url: {{tfm-api-gateway-local}}/api/catalogo
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "grupo": "TEST_QA",
    "idOpcion": 1,
    "opcion": "Opcion de prueba QA"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("catalogoId", res.body.id);
  }
}

tests {
  test("creado (200/201)", function() {
    expect(res.status).to.be.oneOf([200, 201]);
  });
  test("devuelve id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
