meta {
  name: Tareas por subproyecto
  type: http
  seq: 10
}
get {
  url: {{baseUrl}}/api/tareas/por-subproyecto/{{subproyectoId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 200", function() { expect(res.status).to.equal(200); });
  test("incluye la tarea creada", function() {
    const items = res.body.items || res.body;
    expect(items.map(t => t.id)).to.include(bru.getVar("tareaId"));
  });
}
