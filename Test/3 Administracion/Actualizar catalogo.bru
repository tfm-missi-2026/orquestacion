meta {
  name: Actualizar catalogo
  type: http
  seq: 5
}

put {
  url: {{tfm-api-gateway-local}}/api/catalogo/{{catalogoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "grupo": "TEST_QA",
    "idOpcion": 1,
    "opcion": "Opcion de prueba QA (editada)"
  }
}

tests {
  test("actualizado 200", function() {
    expect(res.status).to.equal(200);
  });
}
