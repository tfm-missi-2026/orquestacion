meta {
  name: Actualizar modulo
  type: http
  seq: 16
}

put {
  url: {{tfm-api-gateway-local}}/api/modulos/{{createdModuloId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Modulo QA (editado)",
    "ruta": "/qa",
    "icono": "beaker",
    "orden": 99,
    "moduloPadreId": null,
    "descripcion": "Actualizado por la coleccion Bruno",
    "estado": 1
  }
}

tests {
  test("actualizado 200", function() {
    expect(res.status).to.equal(200);
  });
}
