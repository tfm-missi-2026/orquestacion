meta {
  name: Obtener tarea
  type: http
  seq: 12
}

get {
  url: {{tfm-api-gateway-local}}/api/tareas/{{tareaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("es la tarea creada", function() {
    expect(res.body.id).to.equal(bru.getVar("tareaId"));
  });
}
