meta {
  name: Crear actividad
  type: http
  seq: 7
}

post {
  url: {{tfm-api-gateway-local}}/api/actividades
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "tipoActividadId": "{{catTipoActividad}}",
    "modalidadId": "{{catModalidad}}",
    "titulo": "Reunion de seguimiento QA",
    "descripcion": "Actividad creada por la coleccion Bruno",
    "fecha": "2026-06-02",
    "horaInicio": "09:00:00",
    "horaFin": "10:00:00",
    "organizadorId": "{{adminUserId}}"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("actividadId", res.body.id);
  }
}

tests {
  test("creada (200/201)", function() {
    expect(res.status).to.be.oneOf([200, 201]);
  });
  test("devuelve id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
