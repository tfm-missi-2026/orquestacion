meta {
  name: Actualizar proyecto
  type: http
  seq: 4
}
put {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "nombreCorto": "QA-{{runId}}",
    "nombre": "Sistema de prueba QA actualizado {{runId}}",
    "gestorId": "{{adminUserId}}"
  }
}
tests {
  test("actualizado 200", function() { expect(res.status).to.equal(200); });
  test("refleja el cambio", function() { expect(res.body.nombre).to.contain("actualizado"); });
}
