meta {
  name: Asignaciones por usuario
  type: http
  seq: 4
}

get {
  url: {{tfm-api-gateway-local}}/api/asignaciones/por-usuario/{{adminUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("incluye la asignacion creada", function() {
    expect(res.body.some(a => a.id === bru.getVar("asignacionId"))).to.be.true;
  });
}
