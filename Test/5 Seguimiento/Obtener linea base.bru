meta {
  name: Obtener linea base
  type: http
  seq: 19
}

get {
  url: {{tfm-api-gateway-local}}/api/linea-base/{{lineaBaseId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("es la linea base creada", function() {
    expect(res.body.id).to.equal(bru.getVar("lineaBaseId"));
  });
}
