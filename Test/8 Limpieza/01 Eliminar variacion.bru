meta {
  name: Eliminar variacion
  type: http
  seq: 1
}
delete {
  url: {{baseUrl}}/api/variaciones/{{variacionId}}
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "motivoEliminacion": "Limpieza de la corrida {{runId}}"
  }
}
tests {
  test("eliminado (204)", function() { expect(res.status).to.equal(204); });
}
