meta {
  name: Catalogo por grupo
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/catalogo/grupo/PRIORIDAD
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("todas las opciones son del grupo pedido", function() {
    expect(res.body).to.be.an("array").that.is.not.empty;
    res.body.forEach(i => expect(i.grupo).to.equal("PRIORIDAD"));
  });
}
