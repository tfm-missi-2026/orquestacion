meta {
  name: Crear modulo
  type: http
  seq: 11
}
post {
  url: {{baseUrl}}/api/modulos
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "codigo": "QA_MOD_{{runId}}",
    "nombre": "Modulo QA {{runId}}",
    "icono": "beaker",
    "orden": 99,
    "seccion": "{{moduloSeccion}}",
    "tipo": "MENU",
    "moduloPadreId": null,
    "descripcion": "Modulo creado por la coleccion Bruno"
  }
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("moduloCreadoId", res.body.id);
  }
}
tests {
  test("creado (200/201)", function() { expect(res.status).to.be.oneOf([200, 201]); });
  test("devuelve id", function() { expect(res.body.id).to.be.a("string"); });
}
