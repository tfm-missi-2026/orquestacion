meta {
  name: Avance por proyecto
  type: http
  seq: 20
}

get {
  url: {{tfm-api-gateway-local}}/api/avance/por-proyecto/{{proyectoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  RF-09: compara la linea base congelada (40 h estimadas) contra lo registrado en
  bitacora. Requiere haber congelado linea base antes.
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("incluye porcentaje de avance", function() {
    expect(res.body).to.have.property("porcentajeAvance");
  });
}
