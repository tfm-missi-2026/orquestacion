meta {
  name: Crear proyecto
  type: http
  seq: 1
}

post {
  url: {{tfm-api-gateway-local}}/api/proyectos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombreCorto": "QA-SYS",
    "nombre": "Sistema de prueba QA",
    "descripcion": "Proyecto creado por la coleccion Bruno",
    "gestorId": "{{adminUserId}}"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("proyectoId", res.body.id);
  }
}

tests {
  test("creado (200/201)", function() {
    expect(res.status).to.be.oneOf([200, 201]);
  });
  test("devuelve id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
