meta {
  name: Crear usuario
  type: http
  seq: 19
}

post {
  url: {{tfm-api-gateway-local}}/api/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "qa.bruno@srp.local",
    "contrasenia": "Qa123456",
    "nombres": "QA",
    "apellidoPaterno": "Bruno",
    "apellidoMaterno": "Test",
    "rolId": "{{rolRecurso}}"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("createdUsuarioId", res.body.id);
  }
}

tests {
  test("creado (200/201)", function() {
    expect(res.status).to.be.oneOf([200, 201]);
  });
  test("devuelve id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
