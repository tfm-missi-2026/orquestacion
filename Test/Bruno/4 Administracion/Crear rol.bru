meta {
  name: Crear rol
  type: http
  seq: 6
}
post {
  url: {{baseUrl}}/api/roles
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "codigo": "QA_ROL_{{runId}}",
    "nombre": "Rol de prueba {{runId}}",
    "descripcion": "Rol creado por la coleccion Bruno",
    "paginaInicioId": "{{paginaInicioId}}"
  }
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("rolCreadoId", res.body.id);
  }
}
tests {
  test("creado (200/201)", function() { expect(res.status).to.be.oneOf([200, 201]); });
  test("devuelve id", function() { expect(res.body.id).to.be.a("string"); });
}
