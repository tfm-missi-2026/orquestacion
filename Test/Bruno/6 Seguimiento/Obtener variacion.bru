meta {
  name: Obtener variacion
  type: http
  seq: 24
}
get {
  url: {{baseUrl}}/api/variaciones/{{variacionId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 200", function() { expect(res.status).to.equal(200); });
  test("es la variacion creada", function() { expect(res.body.id).to.equal(bru.getVar("variacionId")); });
}
