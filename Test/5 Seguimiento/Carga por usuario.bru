meta {
  name: Carga por usuario
  type: http
  seq: 22
}

get {
  url: {{tfm-api-gateway-local}}/api/carga/por-usuario/{{adminUserId}}?desde=2026-06-01&hasta=2026-06-30
  body: none
  auth: bearer
}

params:query {
  desde: 2026-06-01
  hasta: 2026-06-30
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("es la carga del usuario consultado", function() {
    expect(res.body).to.have.property("usuarioId");
  });
}
