meta {
  name: Obtener usuario
  type: http
  seq: 18
}
get {
  url: {{baseUrl}}/api/usuarios/{{usuarioCreadoId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 200", function() { expect(res.status).to.equal(200); });
  test("es el usuario creado", function() { expect(res.body.id).to.equal(bru.getVar("usuarioCreadoId")); });
}
