meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "contrasenia": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.tokenAcceso);
    bru.setVar("adminUserId", res.body.usuario.id);
    bru.setVar("adminRolId", res.body.usuario.rol.id);
  }
}

tests {
  test("login correcto 200", function() {
    expect(res.status).to.equal(200);
  });
  test("devuelve token", function() {
    expect(res.body.tokenAcceso).to.be.a("string");
  });
  test("captura el id del usuario autenticado", function() {
    expect(bru.getVar("adminUserId")).to.be.a("string");
  });
}
