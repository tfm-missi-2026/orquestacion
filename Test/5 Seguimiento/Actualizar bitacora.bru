meta {
  name: Actualizar bitacora
  type: http
  seq: 16
}

put {
  url: {{tfm-api-gateway-local}}/api/bitacora/{{bitacoraId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "fecha": "2026-06-02",
    "horaInicio": "08:00:00",
    "horaFin": "13:00:00",
    "descripcion": "Trabajo en tarea QA (editado)",
    "asignacionId": "{{asignacionId}}",
    "actividadId": null
  }
}

tests {
  test("actualizada 200", function() {
    expect(res.status).to.equal(200);
  });
}
