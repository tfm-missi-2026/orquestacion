meta {
  name: Crear modulo
  type: http
  seq: 15
}

post {
  url: {{tfm-api-gateway-local}}/api/modulos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "codigo": "QA_MOD",
    "nombre": "Modulo QA",
    "ruta": "/qa",
    "icono": "beaker",
    "orden": 99,
    "moduloPadreId": null,
    "descripcion": "Modulo creado por la coleccion Bruno"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("createdModuloId", res.body.id);
  }
}

tests {
  test("creado (200/201)", function() {
    expect(res.status).to.be.oneOf([200, 201]);
  });
  test("devuelve id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
