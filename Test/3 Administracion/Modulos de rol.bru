meta {
  name: Modulos de rol
  type: http
  seq: 10
}

get {
  url: {{tfm-api-gateway-local}}/api/roles/{{rolAdmin}}/modulos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("ADMIN tiene modulos asignados", function() {
    expect(res.body).to.be.an("array").that.is.not.empty;
  });
}
