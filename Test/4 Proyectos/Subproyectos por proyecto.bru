meta {
  name: Subproyectos por proyecto
  type: http
  seq: 6
}

get {
  url: {{tfm-api-gateway-local}}/api/subproyectos/por-proyecto/{{proyectoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("incluye el subproyecto creado", function() {
    expect(res.body.some(s => s.id === bru.getVar("subproyectoId"))).to.be.true;
  });
}
