meta {
  name: Actualizar modulo
  type: http
  seq: 13
}
put {
  url: {{baseUrl}}/api/modulos/{{moduloCreadoId}}
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "nombre": "Modulo QA actualizado {{runId}}",
    "icono": "beaker",
    "orden": 98,
    "seccion": "{{moduloSeccion}}",
    "tipo": "MENU",
    "descripcion": "Actualizado por la coleccion Bruno"
  }
}
tests {
  test("actualizado 200", function() { expect(res.status).to.equal(200); });
  test("refleja el cambio", function() { expect(res.body.nombre).to.contain("actualizado"); });
}
