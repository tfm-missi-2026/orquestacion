# SPSRT - Sistema de Planificacion y Seguimiento de Recursos Tecnicos
# Variables de entorno para docker-compose.
# Copiar este archivo a .env y ajustar los valores antes de levantar el stack.

# ---- Layout del workspace ----
# Ruta a la carpeta que contiene los repos de backend, relativa a orquestacion/.
# La usa docker-compose.yml en el build.context de los 5 servicios:
#     context: ${BACKEND_ROOT:-../Backend}/<servicio>
#
# Valor por defecto: ../Backend  (el layout que documenta el README)
#     <workspace>/
#     |- orquestacion/
#     |- Backend/  -> eureka-server, api-gateway, ms-administracion,
#     |               ms-proyectos, ms-seguimiento
#     |- Frontend/
#
# Si los repos estan clonados como hermanos directos de orquestacion (sin la
# carpeta Backend/ intermedia), descomentar la linea de abajo y dejarla en: ..
# Para ver como resuelve en tu maquina:  docker compose config
#BACKEND_ROOT=../Backend

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# Cada microservicio usa una base de datos logica distinta dentro del mismo cluster.
DB_ADMINISTRACION_NAME=spsrt_administracion
DB_ADMINISTRACION_USER=spsrt_administracion_user
DB_ADMINISTRACION_PASSWORD=spsrt_administracion_pwd

DB_PROYECTOS_NAME=spsrt_proyectos
DB_PROYECTOS_USER=spsrt_proyectos_user
DB_PROYECTOS_PASSWORD=spsrt_proyectos_pwd

DB_SEGUIMIENTO_NAME=spsrt_seguimiento
DB_SEGUIMIENTO_USER=spsrt_seguimiento_user
DB_SEGUIMIENTO_PASSWORD=spsrt_seguimiento_pwd

# ---- Spring Cloud Eureka ----
EUREKA_HOST=eureka-server
EUREKA_PORT=8761

# ---- JWT ----
# Clave secreta compartida entre api-gateway y los microservicios para HS256.
# En entornos reales sustituir por un par de claves RS256 publicadas via JWKS.
JWT_SECRET=cambiar-esta-clave-en-produccion-minimo-32-bytes-aleatorios
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_MINUTES=480

# ---- Puertos expuestos al host ----
GATEWAY_PORT=8080
EUREKA_DASHBOARD_PORT=8761
MS_ADMINISTRACION_PORT=8081
MS_PROYECTOS_PORT=8082
MS_SEGUIMIENTO_PORT=8083
FRONTEND_PORT=4200
