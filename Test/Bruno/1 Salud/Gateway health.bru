meta {
  name: Gateway health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/actuator/health
  body: none
  auth: none
}

script:pre-request {
  // Identificador unico de esta corrida. Todos los codigos y correos que
  // la coleccion cree lo llevan como sufijo, de modo que la coleccion se
  // puede reejecutar sin resetear la base y sin chocar con el seed.
  if (!bru.getVar("runId")) {
    bru.setVar("runId", Date.now().toString(36));
  }
}

tests {
  test("gateway responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("estado UP", function() {
    expect(res.body.status).to.equal("UP");
  });
  test("runId generado para la corrida", function() {
    expect(bru.getVar("runId")).to.be.a("string");
  });
}
