meta {
  name: Crear actividad
  type: http
  seq: 8
}
post {
  url: {{baseUrl}}/api/actividades
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "tipoActividadId": "{{catTipoActividad}}",
    "modalidadId": "{{catModalidad}}",
    "titulo": "Reunion de prueba {{runId}}",
    "fecha": "2026-08-04",
    "horaInicio": "09:00:00",
    "horaFin": "10:00:00",
    "organizadorId": "{{adminUserId}}"
  }
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("actividadId", res.body.id);
  }
}
tests {
  test("creada (200/201)", function() { expect(res.status).to.be.oneOf([200, 201]); });
  test("devuelve id", function() { expect(res.body.id).to.be.a("string"); });
}
