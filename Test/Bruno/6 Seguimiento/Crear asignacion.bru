meta {
  name: Crear asignacion
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/api/asignaciones
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "tareaId": "{{tareaId}}",
    "usuarioId": "{{usuarioCreadoId}}",
    "horasPlanificadas": 20,
    "fechaInicioPlanificada": "2026-08-03",
    "fechaFinPlanificada": "2026-08-07",
    "confirmarSobrecarga": false
  }
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("asignacionId", res.body.id);
  }
}
tests {
  test("creada (200/201)", function() { expect(res.status).to.be.oneOf([200, 201]); });
  test("devuelve id", function() { expect(res.body.id).to.be.a("string"); });
}
