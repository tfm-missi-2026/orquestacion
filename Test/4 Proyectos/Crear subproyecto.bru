meta {
  name: Crear subproyecto
  type: http
  seq: 5
}

post {
  url: {{tfm-api-gateway-local}}/api/subproyectos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "proyectoId": "{{proyectoId}}",
    "tipoSubproyectoId": "{{catTipoSubproyecto}}",
    "codigoTicket": "QA-001",
    "prioridadId": "{{catPrioridad}}",
    "descripcion": "Subproyecto de prueba QA",
    "solicitanteId": "{{adminUserId}}",
    "fechaSolicitud": "2026-06-01",
    "situacionId": "{{catSituacion}}"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("subproyectoId", res.body.id);
  }
}

tests {
  test("creado (200/201)", function() {
    expect(res.status).to.be.oneOf([200, 201]);
  });
  test("devuelve id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
