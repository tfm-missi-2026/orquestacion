meta {
  name: Mi usuario
  type: http
  seq: 18
}

get {
  url: {{tfm-api-gateway-local}}/api/usuarios/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("es el usuario admin autenticado", function() {
    expect(res.body.email).to.equal("admin@srp.local");
  });
}
