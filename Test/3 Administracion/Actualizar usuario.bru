meta {
  name: Actualizar usuario
  type: http
  seq: 21
}

put {
  url: {{tfm-api-gateway-local}}/api/usuarios/{{createdUsuarioId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "qa.bruno@srp.local",
    "nombres": "QA Editado",
    "apellidoPaterno": "Bruno",
    "apellidoMaterno": "Test",
    "rolId": "{{rolRecurso}}"
  }
}

tests {
  test("actualizado 200", function() {
    expect(res.status).to.equal(200);
  });
}
