meta {
  name: Crear variacion
  type: http
  seq: 23
}

post {
  url: {{tfm-api-gateway-local}}/api/variaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "tareaId": "{{tareaId}}",
    "tipoVariacionId": "{{catTipoVariacion}}",
    "descripcion": "Ampliacion de plazo de la tarea QA",
    "justificacion": "Dependencia externa retraso el inicio",
    "valorAnterior": "fecha_fin=2026-06-07",
    "valorNuevo": "fecha_fin=2026-06-14",
    "fechaDeteccion": "2026-06-05",
    "reportadaPor": "{{adminUserId}}",
    "situacionId": "{{catSituacionVariacion}}"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("variacionId", res.body.id);
  }
}

tests {
  test("creada (200/201)", function() {
    expect(res.status).to.be.oneOf([200, 201]);
  });
  test("devuelve id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
