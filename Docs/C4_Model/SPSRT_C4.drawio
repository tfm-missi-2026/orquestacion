  <!-- ============================ 1. CONTEXTO ============================ -->
  <diagram name="1. Contexto" id="c4-contexto">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ctx_title" value="C4 · Nivel 1 — Diagrama de Contexto · SPSRT" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=14;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="500" height="24" as="geometry" /></mxCell>
        <mxCell id="ctx_a1" value="Jefe del Área de Desarrollo (A1)&lt;br&gt;[Persona]&lt;br&gt;Visión transversal de la carga; detecta sobreasignación; valida la planificación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="190" height="100" as="geometry" /></mxCell>
        <mxCell id="ctx_a2" value="Gestor de Proyecto (A2)&lt;br&gt;[Persona]&lt;br&gt;Planifica, asigna recursos, registra variaciones y sigue el avance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="190" height="100" as="geometry" /></mxCell>
        <mxCell id="ctx_a3" value="Recurso Técnico (A3)&lt;br&gt;[Persona]&lt;br&gt;Consulta sus asignaciones, registra dedicación real y reporta variaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="190" height="100" as="geometry" /></mxCell>
        <mxCell id="ctx_a4" value="Administrador (A4)&lt;br&gt;[Persona]&lt;br&gt;Gestiona el ciclo de vida de usuarios y permisos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="70" width="190" height="100" as="geometry" /></mxCell>
        <mxCell id="ctx_sys" value="SPSRT&lt;br&gt;[Sistema de software]&lt;br&gt;Planificación y seguimiento de recursos técnicos: planificación de recursos (C1), seguimiento de la ejecución (C2) y registro de variaciones (C3). Autoalojable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="360" width="300" height="140" as="geometry" /></mxCell>
