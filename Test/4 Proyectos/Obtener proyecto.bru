meta {
  name: Obtener proyecto
  type: http
  seq: 3
}

get {
  url: {{tfm-api-gateway-local}}/api/proyectos/{{proyectoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("es el proyecto creado", function() {
    expect(res.body.id).to.equal(bru.getVar("proyectoId"));
  });
}
