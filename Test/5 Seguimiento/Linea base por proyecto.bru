meta {
  name: Linea base por proyecto
  type: http
  seq: 18
}

get {
  url: {{tfm-api-gateway-local}}/api/linea-base/por-proyecto/{{proyectoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("devuelve lista de lineas base", function() {
    expect(res.body).to.be.an("array").that.is.not.empty;
  });
}
