meta {
  name: Congelar linea base
  type: http
  seq: 16
}
post {
  url: {{baseUrl}}/api/linea-base/congelar
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "proyectoId": "{{proyectoId}}",
    "descripcion": "Linea base de la corrida {{runId}}",
    "tareas": [
      {
        "tareaId": "{{tareaId}}",
        "nombre": "Tarea actualizada {{runId}}",
        "fechaInicioPlanificada": "2026-08-03",
        "fechaFinPlanificada": "2026-08-07",
        "horasEstimadas": 24
      }
    ],
    "asignaciones": [
      {
        "asignacionId": "{{asignacionId}}",
        "tareaId": "{{tareaId}}",
        "usuarioId": "{{usuarioCreadoId}}"
      }
    ]
  }
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("lineaBaseId", res.body.id);
  }
}
tests {
  test("congelada (200/201)", function() { expect(res.status).to.be.oneOf([200, 201]); });
  test("devuelve id de linea base", function() { expect(res.body.id).to.be.a("string"); });
}
