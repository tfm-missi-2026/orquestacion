meta {
  name: Obtener subproyecto
  type: http
  seq: 7
}
get {
  url: {{baseUrl}}/api/subproyectos/{{subproyectoId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 200", function() { expect(res.status).to.equal(200); });
  test("es el subproyecto creado", function() { expect(res.body.id).to.equal(bru.getVar("subproyectoId")); });
}
