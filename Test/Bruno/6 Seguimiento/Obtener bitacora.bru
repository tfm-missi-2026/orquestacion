meta {
  name: Obtener bitacora
  type: http
  seq: 14
}
get {
  url: {{baseUrl}}/api/bitacora/{{bitacoraId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 200", function() { expect(res.status).to.equal(200); });
  test("es el registro creado", function() { expect(res.body.id).to.equal(bru.getVar("bitacoraId")); });
}
