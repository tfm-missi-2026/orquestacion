meta {
  name: Carga del equipo
  type: http
  seq: 21
}

get {
  url: {{tfm-api-gateway-local}}/api/carga/equipo?desde=2026-06-01&hasta=2026-06-30
  body: none
  auth: bearer
}

params:query {
  desde: 2026-06-01
  hasta: 2026-06-30
}

auth:bearer {
  token: {{token}}
}

docs {
  RF-07: carga agregada (planificado vs real) de todo el equipo en el periodo.
  Solo ADMIN/JEFE_AREA/GESTOR_PROYECTO.
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("devuelve lista de carga", function() {
    expect(res.body).to.be.an("array");
  });
}
