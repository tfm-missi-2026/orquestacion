meta {
  name: Actualizar bitacora
  type: http
  seq: 15
}
put {
  url: {{baseUrl}}/api/bitacora/{{bitacoraId}}
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "fecha": "2026-08-03",
    "horaInicio": "09:00:00",
    "horaFin": "14:00:00",
    "descripcion": "Trabajo actualizado en la tarea {{runId}}",
    "asignacionId": "{{asignacionSobrecargaId}}"
  }
}
tests {
  test("actualizada 200", function() { expect(res.status).to.equal(200); });
  test("refleja el cambio", function() { expect(res.body.descripcion).to.contain("actualizado"); });
}
