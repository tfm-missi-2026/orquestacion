meta {
  name: Subproyectos por proyecto
  type: http
  seq: 6
}
get {
  url: {{baseUrl}}/api/subproyectos/por-proyecto/{{proyectoId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 200", function() { expect(res.status).to.equal(200); });
  test("incluye el subproyecto creado", function() {
    const items = res.body.items || res.body;
    expect(items.map(s => s.id)).to.include(bru.getVar("subproyectoId"));
  });
}
