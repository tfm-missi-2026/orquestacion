meta {
  name: Obtener modulo
  type: http
  seq: 12
}
get {
  url: {{baseUrl}}/api/modulos/{{moduloCreadoId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 200", function() { expect(res.status).to.equal(200); });
  test("es el modulo creado", function() { expect(res.body.id).to.equal(bru.getVar("moduloCreadoId")); });
}
