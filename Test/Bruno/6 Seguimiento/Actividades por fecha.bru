meta {
  name: Actividades por fecha
  type: http
  seq: 9
}
get {
  url: {{baseUrl}}/api/actividades/por-fecha?fecha=2026-08-04
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 200", function() { expect(res.status).to.equal(200); });
  test("incluye la actividad creada", function() {
    const items = res.body.items || res.body;
    expect(items.map(a => a.id)).to.include(bru.getVar("actividadId"));
  });
}
