meta {
  name: Obtener linea base
  type: http
  seq: 18
}
get {
  url: {{baseUrl}}/api/linea-base/{{lineaBaseId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 200", function() { expect(res.status).to.equal(200); });
  test("es la linea base congelada", function() { expect(res.body.id).to.equal(bru.getVar("lineaBaseId")); });
}
