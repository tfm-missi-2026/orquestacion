meta {
  name: Listar roles
  type: http
  seq: 6
}

get {
  url: {{tfm-api-gateway-local}}/api/roles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("incluye los 4 roles base", function() {
    expect(res.body.length).to.be.at.least(4);
  });
}
