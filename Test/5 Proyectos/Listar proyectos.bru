meta {
  name: Listar proyectos
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/api/proyectos
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 200", function() { expect(res.status).to.equal(200); });
  test("incluye el proyecto creado", function() {
    const items = res.body.items || res.body;
    expect(items.map(p => p.id)).to.include(bru.getVar("proyectoId"));
  });
}
