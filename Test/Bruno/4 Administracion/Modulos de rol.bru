meta {
  name: Modulos de rol
  type: http
  seq: 9
}
get {
  url: {{baseUrl}}/api/roles/{{rolCreadoId}}/modulos
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("responde 200", function() { expect(res.status).to.equal(200); });
  test("devuelve lista de modulos del rol", function() {
    expect(res.body.items || res.body).to.be.an("array");
  });
}
