meta {
  name: Actualizar subproyecto
  type: http
  seq: 8
}

put {
  url: {{tfm-api-gateway-local}}/api/subproyectos/{{subproyectoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "tipoSubproyectoId": "{{catTipoSubproyecto}}",
    "codigoTicket": "QA-001",
    "prioridadId": "{{catPrioridad}}",
    "descripcion": "Subproyecto de prueba QA (editado)",
    "situacionId": "{{catSituacion}}",
    "justificacionRechazo": null
  }
}

tests {
  test("actualizado 200", function() {
    expect(res.status).to.equal(200);
  });
}
