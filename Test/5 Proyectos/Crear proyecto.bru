meta {
  name: Crear proyecto
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/api/proyectos
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "nombreCorto": "QA-{{runId}}",
    "nombre": "Sistema de prueba QA {{runId}}",
    "gestorId": "{{adminUserId}}"
  }
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("proyectoId", res.body.id);
  }
}
tests {
  test("creado (200/201)", function() { expect(res.status).to.be.oneOf([200, 201]); });
  test("devuelve id", function() { expect(res.body.id).to.be.a("string"); });
  test("el gestor es el usuario autenticado", function() {
    expect(res.body.gestorId).to.equal(bru.getVar("adminUserId"));
  });
}
