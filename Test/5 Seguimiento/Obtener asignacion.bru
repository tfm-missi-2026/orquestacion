meta {
  name: Obtener asignacion
  type: http
  seq: 6
}

get {
  url: {{tfm-api-gateway-local}}/api/asignaciones/{{asignacionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("es la asignacion creada", function() {
    expect(res.body.id).to.equal(bru.getVar("asignacionId"));
  });
}
