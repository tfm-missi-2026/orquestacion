meta {
  name: Tareas por subproyecto
  type: http
  seq: 11
}

get {
  url: {{tfm-api-gateway-local}}/api/tareas/por-subproyecto/{{subproyectoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("incluye la tarea creada", function() {
    expect(res.body.some(t => t.id === bru.getVar("tareaId"))).to.be.true;
  });
}
