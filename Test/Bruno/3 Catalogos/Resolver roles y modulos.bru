meta {
  name: Resolver roles y modulos
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/roles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  // Los listados devuelven {items, total, ...}. Se lee items y, si el
  // endpoint dejara de paginar, se cae al cuerpo directo.
  if (res.status === 200) {
    const items = res.body.items || res.body;
    const porCodigo = (c) => {
      const r = items.find(i => i.codigo === c);
      return r ? r.id : null;
    };
    bru.setVar("rolRecursoId", porCodigo("RECURSO_TECNICO"));
    bru.setVar("rolGestorId", porCodigo("GESTOR_PROYECTO"));
    const base = items.find(i => i.paginaInicioId);
    bru.setVar("paginaInicioId", base ? base.paginaInicioId : null);
  }
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("devuelve listado paginado", function() {
    expect(res.body.items).to.be.an("array").that.is.not.empty;
  });
  test("captura el rol de recurso tecnico", function() {
    expect(bru.getVar("rolRecursoId")).to.be.a("string");
  });
  test("captura una pagina de inicio valida", function() {
    expect(bru.getVar("paginaInicioId")).to.be.a("string");
  });
}
