meta {
  name: Listar modulos
  type: http
  seq: 12
}

get {
  url: {{tfm-api-gateway-local}}/api/modulos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("devuelve lista de modulos", function() {
    expect(res.body).to.be.an("array").that.is.not.empty;
  });
}
